# ─────────────────────────────────────────────────────────────────────────────
# Owo environment template (Appendix C). Copy to `.env` for local dev.
# In staging/production these come from a SECRETS MANAGER, never committed files
# (Section 10/12). Signer KEYS live in KMS/HSM — only their references go here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Chain ──
# Default to Alfajores (staging testnet). Mainnet: 42220 / https://forno.celo.org
CELO_CHAIN_ID=44787
CELO_RPC_URL=https://alfajores-forno.celo-testnet.org
ALFAJORES_RPC_URL=https://alfajores-forno.celo-testnet.org
GDOLLAR_TOKEN_ADDRESS=
STABLE_TOKEN_ADDRESS=
IDENTITY_CONTRACT_ADDRESS=
OWO_ESCROW_ADDRESS=
OWO_TREASURY_ADDRESS=
OWO_REWARDS_ADDRESS=

# ── Account abstraction / gasless ──
PAYMASTER_URL=
BUNDLER_URL=
EMBEDDED_WALLET_KEY=

# ── Signers (KMS references, NOT raw keys) ──
OWO_MULTISIG_OWNER=
CONFIRMATION_SIGNER_ADDRESS=
CONFIRMATION_SIGNER_KMS=
TREASURY_OPERATOR_ADDRESS=
TREASURY_SIGNER_KMS=
REWARDS_GRANTER_ADDRESS=

# ── Providers (swappable adapters) ──
PSP_API_KEY=
PSP_WEBHOOK_SECRET=
BILLER_API_KEY=
BILLER_WEBHOOK_SECRET=
KYC_API_KEY=
SANCTIONS_API_KEY=

# ── Data ──
DATABASE_URL=postgresql://owo:owo@localhost:5432/owo
REDIS_URL=redis://localhost:6379

# ── Observability ──
SENTRY_DSN=

# ── Frontend (Vite — VITE_ prefixed vars are exposed to the browser) ──
VITE_REOWN_PROJECT_ID=
VITE_CELO_CHAIN_ID=44787
VITE_CELO_RPC_URL=https://alfajores-forno.celo-testnet.org
VITE_GDOLLAR_TOKEN_ADDRESS=
VITE_API_BASE_URL=http://localhost:3001
