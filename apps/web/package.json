{
  "name": "@owo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Owo PWA — React + Vite, mobile-first, MiniPay-ready (Section 13).",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "lint": "pnpm exec eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo node_modules/.vite"
  },
  "dependencies": {
    "@owo/sdk": "workspace:*",
    "@owo/ui": "workspace:*",
    "@reown/appkit": "1.7.8",
    "@reown/appkit-adapter-wagmi": "1.7.8",
    "@tanstack/react-query": "^5.51.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.45.0",
    "wagmi": "2.15.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.1",
    "vitest": "^2.0.5"
  }
}
