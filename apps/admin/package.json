{
  "name": "@owo/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Owo ops console — disputes, KYC review, treasury controls, kill-switches (Section 5).",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --port 5174",
    "preview": "vite preview",
    "lint": "pnpm exec eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo node_modules/.vite"
  },
  "dependencies": {
    "@owo/sdk": "workspace:*",
    "@owo/ui": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
