{
  "name": "owo",
  "version": "0.0.0",
  "private": true,
  "description": "Owo — a circular G$ economy for Nigeria (spend rail + P2P G$↔Naira marketplace) on Celo.",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "pnpm": {
    "overrides": {
      "viem": "^2.45.0",
      "@wagmi/core": "2.22.1",
      "@wagmi/connectors": "5.8.5"
    },
    "onlyBuiltDependencies": ["@nestjs/core", "esbuild", "keccak", "bufferutil", "utf-8-validate"]
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "turbo": "^2.5.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0"
  }
}
